{
  "name": "ctc-sante-desktop",
  "version": "1.0.0",
  "description": "CTC Santé - Medical Transportation Management Desktop Application",
  "main": "public/electron.js",
  "homepage": "./",
  "author": "Hassan",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0",
    "axios": "^1.6.0",
    "crypto-js": "^4.1.1",
    "date-fns": "^2.30.0",
    "electron-squirrel-startup": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "electron-is-dev": "^2.0.0",
    "concurrently": "^8.2.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.1.4",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "electron-dev": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && ELECTRON_DEV=true electron .\"",
    "electron-build": "npm run react-build && electron-builder",
    "electron-build-win": "npm run electron-build -- --win",
    "electron-build-mac": "npm run electron-build -- --mac",
    "electron-build-linux": "npm run electron-build -- --linux",
    "start": "electron .",
    "build": "npm run react-build && npm run electron-build"
  },
  "build": {
    "appId": "com.ctcsante.desktop",
    "productName": "CTC Santé",
    "files": [
      "public/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  }
}
